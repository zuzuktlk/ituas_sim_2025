<?xml version="1.0" ?>
<sdf version='1.11'>
  <model name='boat'>
    <link name='base_link'>
    <!--lidar verisi için sensor-->
    
  
    <sensor name='gpu_lidar' type='gpu_lidar'>
    
        <pose relative_to='base_link'>0.5 0 0.6 0 0 0</pose>
        <topic>/lidar</topic>
        <update_rate>10</update_rate>
        <visualize>true</visualize> <ray>
            <scan>
                <horizontal>
                    <samples>640</samples>
                    <resolution>1</resolution>
                    <min_angle>-1.5707</min_angle>
                    <max_angle>1.5707</max_angle>
                </horizontal>
                <vertical>
                    <samples>1</samples>
                    <resolution>0.01</resolution>
                    <min_angle>0</min_angle>
                    <max_angle>0</max_angle>
                </vertical>
            </scan>
            <range>
                <min>0.10</min>
                <max>50.0</max> <resolution>0.01</resolution>
            </range>
        </ray>
        <always_on>1</always_on>
<frame_id>gpu_lidar</frame_id>
    </sensor>
   
    
    	  <!--kamera verisi için (ağırlığı yok kütlesiz)-->    	  
    <visual name="camera_visual_ghost">
      <pose>0 0 0.4 0 0 0</pose> <geometry>
        <box><size>0.1 0.1 0.1</size></box>
      </geometry>
      <material>	
        <ambient>1 0 0 1</ambient> </material>
    </visual>

<sensor name="camera_sensor_rgb" type="camera">
      <pose>0.5 0 0.4 0 0 0</pose> <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>camera/image_raw</topic>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
    </sensor>

    <sensor name="camera_sensor_depth" type="depth_camera">
      <pose>0.5 0 0.4 0 0 0</pose> <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>camera/depth/image_raw</topic>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R_FLOAT32</format> </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
    </sensor>
    
    
    
      <inertial>
        <!-- TAHMIN (v1): toplam 30 kg (base 27.8 + 2x1.0 mahfaza + 2x0.1 pervane).
             x,y: motorlarla birlikte TOPLAM agirlik merkezi kaldirma merkezine (-0.013,-0.006) gelecek sekilde (v2), z: su hattinin ~14 cm ustu.
             Atalet: yaricap-jirasyon tahmini kxx=0.29, kyy=0.30, kzz=0.33 m. CAD gelince guncellenecek. -->
        <pose>0.0203 -0.0056 -0.05 0 0 0</pose>
        <mass>27.8</mass>
        <inertia>
          <ixx>2.34</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.50</iyy>
          <iyz>0</iyz>
          <izz>3.03</izz>
        </inertia>
      </inertial>
      
   <!-- PONTONLAR: STL govdesinden (olcek 1) katman katman uydurulmus kutular.
           Kesit V seklinde oldugu icin 4 katman; genislikler katman hacmine esitlendi.
           v2: kutular sadece temas/carpisma icin; kaldirmayi VRX Surface veriyor. -->
      <collision name='hull_left_1'>
        <pose>-0.047 0.252 -0.312 0 0 0</pose>
        <geometry><box><size>0.925 0.048 0.040</size></box></geometry>
      </collision>
      <collision name='hull_left_2'>
        <pose>-0.018 0.252 -0.267 0 0 0</pose>
        <geometry><box><size>1.000 0.105 0.050</size></box></geometry>
      </collision>
      <collision name='hull_left_3'>
        <pose>0.000 0.252 -0.195 0 0 0</pose>
        <geometry><box><size>1.090 0.148 0.094</size></box></geometry>
      </collision>
      <collision name='hull_left_4'>
        <pose>0.033 0.252 -0.089 0 0 0</pose>
        <geometry><box><size>1.175 0.190 0.118</size></box></geometry>
      </collision>
      <collision name='hull_right_1'>
        <pose>-0.047 -0.265 -0.312 0 0 0</pose>
        <geometry><box><size>0.925 0.048 0.040</size></box></geometry>
      </collision>
      <collision name='hull_right_2'>
        <pose>-0.018 -0.265 -0.267 0 0 0</pose>
        <geometry><box><size>1.000 0.105 0.050</size></box></geometry>
      </collision>
      <collision name='hull_right_3'>
        <pose>0.000 -0.265 -0.195 0 0 0</pose>
        <geometry><box><size>1.090 0.148 0.094</size></box></geometry>
      </collision>
      <collision name='hull_right_4'>
        <pose>0.033 -0.265 -0.089 0 0 0</pose>
        <geometry><box><size>1.175 0.190 0.118</size></box></geometry>
      </collision>
      
      <visual name='base_link_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://beequeen_diag_nohydro/meshes/stl/denemeas.003.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.4 0.8 1</ambient>
          <diffuse>0.3 0.5 0.9 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>
    </link>
    
    <!-- SOL PERVANE MAHFAZAsı -->
    <link name='left_housing_link'>
      <pose>-0.434 0.248 -0.37 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.002</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.002</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>
    
    <!-- SOL PERVANE -->
    <link name='leftmotor_link'>
      <pose>-0.435 0.248 -0.37 1.5708 0.0 -1.5708</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0002</izz>
        </inertia>
      </inertial>
      <visual name='leftmotor_visual'>
        <pose>0 0 0 -1.5708 0.0 1.5708</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://beequeen_diag_nohydro/meshes/stl/denemeas.001.stl</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    
    <!-- SAĞ PERVANE MAHFAZAsı -->
    <link name='right_housing_link'>
      <pose>-0.434 -0.271 -0.37 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.002</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.002</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>
    
    <!-- SAĞ PERVANE -->
    <link name='rightmotor_link'>
      <pose>-0.435 -0.271 -0.37 1.5708 0.0 -1.5708</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0002</izz>
        </inertia>
      </inertial>
      <visual name='rightmotor_visual'>
        <pose>0 0 0 -1.5708 0.0 1.5708</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://beequeen_diag_nohydro/meshes/stl/denemeas.002.stl</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!-- EKLEMLER -->
    <joint name='left_chassis_engine_joint' type='revolute'>
      <parent>base_link</parent>
      <child>left_housing_link</child>
      <axis>
<xyz>1 0 0</xyz>

        <limit>
          <lower>0</lower>
          <upper>0</upper>
        </limit>
      </axis>
    </joint>
    
    <joint name='right_chassis_engine_joint' type='revolute'>
      <parent>base_link</parent>
      <child>right_housing_link</child>
      <axis>
<xyz>1 0 0</xyz>

        <limit>
          <lower>0</lower>
          <upper>0</upper>
        </limit>
      </axis>
    </joint>
    
<joint name='leftmotor_link_joint' type='revolute'>
  <parent>left_housing_link</parent>
  <child>leftmotor_link</child>
  <axis>
    <xyz>0 0 1</xyz>  <!-- 1 0 0 yerine 0 0 1 -->
    <limit>
      <effort>100</effort>
      <velocity>100</velocity>
    </limit>
    <dynamics>
      <friction>1.0</friction>
      <damping>2.0</damping>
    </dynamics>
  </axis>
</joint>

<joint name='rightmotor_link_joint' type='revolute'>
  <parent>right_housing_link</parent>
  <child>rightmotor_link</child>
  <axis>
    <xyz>0 0 1</xyz>  <!-- 1 0 0 yerine 0 0 1 -->
    <limit>
      <effort>100</effort>
      <velocity>100</velocity>
    </limit>
    <dynamics>
      <friction>1.0</friction>
      <damping>2.0</damping>
    </dynamics>
  </axis>
</joint>

    <!-- THRUSTER PLUGINS -->
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>leftmotor_link_joint</joint_name>
      <thrust_coefficient>0.0001</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.11</propeller_diameter>
      <velocity_control>true</velocity_control>
    </plugin>

    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>rightmotor_link_joint</joint_name>
      <thrust_coefficient>0.0001</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.11</propeller_diameter>
      <velocity_control>true</velocity_control>
    </plugin>

<!-- KALDIRMA (v2): VRX Surface, ponton basina 4 nokta. Her nokta, yaricapi 0.13 m olan
     bir silindirin DIBI; su o noktanin ustune ciktikca daire kesiti kadar kaldirma, kuvvet
     o noktada uygulanir (dogru donme momenti). Noktalarin z'si (-0.268) STL'den hesaplanan
     30 kg su hattini (-0.188) verecek sekilde secildi. V kesite gore su hatti genisligi
     ~1.6 kat fazla: yalpa/baş-kıç yay sertligi biraz yuksek (G7'de gercek veriyle bakilacak). -->
<plugin filename="libSurface.so" name="vrx::Surface">
  <link_name>base_link</link_name>
  <hull_length>1.09</hull_length>
  <hull_radius>0.13</hull_radius>
  <fluid_level>0.0</fluid_level>
  <points>
      <point>-0.422 0.252 -0.268</point>
      <point>-0.149 0.252 -0.268</point>
      <point>0.123 0.252 -0.268</point>
      <point>0.396 0.252 -0.268</point>
  </points>
</plugin>
<plugin filename="libSurface.so" name="vrx::Surface">
  <link_name>base_link</link_name>
  <hull_length>1.09</hull_length>
  <hull_radius>0.13</hull_radius>
  <fluid_level>0.0</fluid_level>
  <points>
      <point>-0.422 -0.265 -0.268</point>
      <point>-0.149 -0.265 -0.268</point>
      <point>0.123 -0.265 -0.268</point>
      <point>0.396 -0.265 -0.268</point>
  </points>
</plugin>
    
    
    

    <!-- DIAG: SimpleHydrodynamics (sonum) cikarildi. Beklenen: sonumsuz, ~0.5 s periyotlu salinim. -->
    
    
    
    <!--nav.py için 
    <plugin
    filename="gz-sim-pose-publisher-system"
    name="gz::sim::systems::PosePublisher">
    <publish_link_pose>true</publish_link_pose>
    <publish_sensor_pose>false</publish_sensor_pose>
    <publish_collision_pose>false</publish_collision_pose>
    <publish_visual_pose>false</publish_visual_pose>
    <publish_nested_model_pose>true</publish_nested_model_pose>
    <use_pose_vector_msg>true</use_pose_vector_msg>
    <update_frequency>20</update_frequency>  https://gazebosim.org/docs/latest/ros2_integration/https://gazebosim.org/docs/latest/ros2_integration/

</plugin>  
-->



<plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>30</odom_publish_frequency>
      <odom_topic>/odom</odom_topic>
      <publish_tf>true</publish_tf>
      <tf_topic>/tf</tf_topic>
    </plugin>

  
  </model>
</sdf>
