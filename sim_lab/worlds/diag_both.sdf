<?xml version="1.0" ?>
<!-- FIXED v2: tek kaldirma kaynagi (teknedeki VRX Surface), 30 kg BeeQueen.
     Fizik motoru ve adim baseline ile ayni; sadece kaldirma modu ve tekne degisti.
     Hedef: tekne ~2 s icinde durulmali, su hatti base_link z = -0.19 (yani model z ~ +0.19). -->
<sdf version="1.10">
  <world name="diag_both">

    <physics name="default" type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <dart>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <!-- v2: dunyada kaldirma eklentisi YOK. Tek kaldirma kaynagi teknedeki VRX Surface.
         (v1 graded buoyancy ile tekne takla atti; nedeni henuz belirlenmedi.) -->

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.8 1.0 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.6 0.6 0.6 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ocean_surface">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.0 0.3 0.5 0.8</ambient>
            <diffuse>0.0 0.4 0.6 0.9</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Isim "boat" kaldi: kontrol.py topic'leri (/model/boat/...) aynen calissin -->
    <include>
      <uri>model://beequeen_diag_both</uri>
      <name>boat</name>
      <pose>0 0 0.30 0 0 0</pose>
    </include>

  </world>
</sdf>
